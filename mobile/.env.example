# Currently, CitiVoice mobile resolves API URL via Expo constants
# However, you can use this for other configurations in the future

EXPO_PUBLIC_API_URL=https://your-public-api-url.loca.lt/api

# Google Sign-In — the *Web application* OAuth client ID (same one the backend uses).
# Leave blank to hide the "Continue with Google" button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional, iOS builds only
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
