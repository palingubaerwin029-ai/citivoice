PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=citivoice
DB_SSL=false
BASE_URL=http://localhost:5000

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_strong_random_string_at_least_64_chars

# Comma-separated list of allowed front-end origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Global rate-limit (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Gmail SMTP (Nodemailer) ──────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password


# ── Groq AI (Concern Categorization & AI Features) ───────────────────────────
# 1. Get an API key from https://console.groq.com/keys
# 2. Paste it below. If left blank, AI features will use rule-based fallback.
GROQ_API_KEY=your_groq_api_key_here

# ── Google Sign-In ───────────────────────────────────────────────────────────
# OAuth client ID(s) from Google Cloud Console → APIs & Services → Credentials.
# Put your *Web application* client ID here (mobile tokens are issued for it too).
# Comma-separate if you need several. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_IDS=

# ── Automated Backup Configuration ───────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_INTERVAL_MS=86400000
BACKUP_MAX_FILES=10
BACKUP_DIR=/usr/src/backups/db


